config_version=5

[application]
config/name="Mystery Escape's"
run/main_scene="res://scenes/main_menu.tscn"
run/max_fps=60
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="A cinematic offline escape-puzzle detective game with 100 main cases and a junior detective mode."
config/icon="res://assets/ui/seal.png"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[gui]
theme/default_font_size=22

